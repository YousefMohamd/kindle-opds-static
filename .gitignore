# Telegram book index (telegram/) — scoped rules only. The OPDS files
# at the repo root (index.xml, khazendar/, sahwa/, electronic/,
# hindawi/, doab/, functions/) are not matched by any rule here.

# SQLite sidecars are never committed (they are rebuilt on open).
telegram/index.db-wal
telegram/index.db-shm
telegram/*.db-wal
telegram/*.db-shm

# The seed DB is committed by design, but ONLY COMPRESSED and SPLIT
# into 20 MB parts (telegram/index.db.gz.part-aa, ...): it is the seed
# the scheduled GitHub Actions job resumes from (public-channel
# metadata only — no account, no private chats). The compressed DB is
# now ~66 MB, over Cloudflare Pages' 25 MB per-file limit, so a single
# index.db.gz breaks the deployment and the site serves stale data
# (2026-11-09). The raw telegram/index.db and the reassembled single
# telegram/index.db.gz are NEVER committed. Local runs share the same
# files. Other *.db files stay out.
telegram/*.db
telegram/index.db.gz

# python
telegram/.venv/
telegram/__pycache__/
telegram/**/*.pyc
telegram/*.egg-info/
telegram/build/
telegram/dist/

# exports may contain personal chat data — never commit them
telegram/exports/
telegram/result.json

# Staging dir for the atomic publish in the telegram-sync workflow.
site/telegram.new/
